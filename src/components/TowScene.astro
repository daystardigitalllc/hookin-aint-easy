---
// Hero animation: black rollback backs in, tilts, winches a broken-down car aboard, drives off.
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const TILT = 14;
const th = (TILT * Math.PI) / 180;
const PX = 300; // bed pivot (truck-local)
const DECK = 178; // deck top (truck-local)
const REST = 330; // truck rear x while loading
const carCx = 180; // car centre on deck (truck-local)
const rel = carCx - PX;
const endX = REST + PX + rel * Math.cos(th);
const endY = DECK - rel * Math.sin(th);
const dx = +(endX - 240).toFixed(1);
const dy = +(endY - 250).toFixed(1);
---

<div class="scene" aria-label="Animation: a Hookin' Ain't Easy tow truck loads a broken-down car and drives away" role="img">
  <svg viewBox="0 0 1000 330" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg" style={`--dx:${dx}px;--dy:${dy}px;--tilt:${TILT}deg;`}>
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0a0b12" />
        <stop offset=".45" stop-color="#3a1020" />
        <stop offset=".75" stop-color="#b8291a" />
        <stop offset="1" stop-color="#f08a2a" />
      </linearGradient>
      <linearGradient id="chrome" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f4f6f8" />
        <stop offset=".45" stop-color="#8d939b" />
        <stop offset=".55" stop-color="#cfd3d8" />
        <stop offset="1" stop-color="#4a4e55" />
      </linearGradient>
      <linearGradient id="glass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#3b4a5c" />
        <stop offset="1" stop-color="#10151c" />
      </linearGradient>
      <linearGradient id="truckBody" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2a2b2f" />
        <stop offset=".25" stop-color="#0d0d0f" />
        <stop offset="1" stop-color="#050506" />
      </linearGradient>
      <radialGradient id="sun" cx=".5" cy=".5" r=".5">
        <stop offset="0" stop-color="#ffd27a" stop-opacity=".95" />
        <stop offset="1" stop-color="#ff7a2a" stop-opacity="0" />
      </radialGradient>

      <g id="wheel">
        <circle r="30" fill="#0b0b0c" />
        <circle r="30" fill="none" stroke="#2c2d31" stroke-width="3" />
        <g class="spin">
          <circle r="18" fill="url(#chrome)" />
          <circle r="18" fill="none" stroke="#222" stroke-width="1.5" />
          <g stroke="#2b2d31" stroke-width="3" stroke-linecap="round">
            <line x1="-12" y1="0" x2="12" y2="0" />
            <line x1="0" y1="-12" x2="0" y2="12" />
            <line x1="-8.5" y1="-8.5" x2="8.5" y2="8.5" />
            <line x1="-8.5" y1="8.5" x2="8.5" y2="-8.5" />
          </g>
          <circle r="4" fill="#d9dce0" />
        </g>
      </g>

      <!-- broken-down car, origin = bottom centre -->
      <g id="car">
        <path d="M-90,-14 L-90,-30 Q-88,-36 -74,-38 L-48,-42 Q-34,-62 -12,-62 L28,-62 Q46,-62 58,-44 L78,-40 Q90,-38 90,-26 L90,-14 Z" fill="#b3201a" />
        <path d="M-40,-42 Q-30,-57 -12,-57 L-4,-57 L-4,-42 Z" fill="url(#glass)" />
        <path d="M4,-57 L26,-57 Q40,-57 50,-42 L4,-42 Z" fill="url(#glass)" />
        <rect x="-90" y="-20" width="180" height="6" fill="#7b140f" />
        <rect x="-92" y="-30" width="6" height="8" rx="2" class="hazard" fill="#ffb020" />
        <rect x="86" y="-30" width="6" height="8" rx="2" class="hazard" fill="#ffb020" />
        <circle cx="-52" cy="-14" r="15" fill="#0b0b0c" />
        <circle cx="-52" cy="-14" r="7" fill="#aeb3b9" />
        <circle cx="52" cy="-14" r="15" fill="#0b0b0c" />
        <circle cx="52" cy="-14" r="7" fill="#aeb3b9" />
      </g>
    </defs>

    <!-- sky + sun + treeline + road -->
    <rect width="1000" height="330" fill="url(#sky)" />
    <circle cx="760" cy="238" r="120" fill="url(#sun)" />
    <path d="M0,246 L0,214 L18,198 L30,216 L52,190 L70,214 L96,200 L120,220 L150,196 L176,218 L210,204 L240,222 L270,196 L300,218 L340,200 L372,220 L410,194 L446,218 L480,204 L520,222 L560,198 L600,220 L640,200 L680,222 L720,194 L760,218 L800,202 L840,224 L880,196 L920,220 L960,200 L1000,216 L1000,246 Z" fill="#0b0508" />
    <rect y="246" width="1000" height="84" fill="#101013" />
    <rect y="246" width="1000" height="3" fill="#3a3a40" />
    <g stroke="#e9b73f" stroke-width="3" stroke-dasharray="46 40" opacity=".75">
      <line x1="0" y1="298" x2="1000" y2="298" />
    </g>
    <ellipse cx="500" cy="252" rx="330" ry="6" fill="#000" opacity=".5" />

    <!-- car waiting for help -->
    <g class="carA">
      <use href="#car" x="240" y="250" />
    </g>

    <!-- truck (local origin = rear of bed, ground y=250) -->
    <g class="truck">
      <!-- bed + deck -->
      <g class="bed">
        <rect x="0" y="178" width="330" height="22" rx="2" fill="url(#truckBody)" />
        <rect x="0" y="178" width="330" height="3" fill="url(#chrome)" />
        <rect x="-6" y="178" width="14" height="22" rx="2" fill="#17181b" />
        <g fill="#2a2b2f">
          <rect x="30" y="184" width="270" height="2" />
          <rect x="30" y="192" width="270" height="2" />
        </g>
        <!-- headache rack -->
        <rect x="318" y="108" width="10" height="70" fill="#0c0c0e" />
        <rect x="318" y="108" width="10" height="3" fill="url(#chrome)" />
        <!-- winch -->
        <rect x="286" y="170" width="26" height="8" rx="2" fill="#4a4e55" />
        <g class="cable" style="transform-origin:299px 174px">
          <line x1="299" y1="174" x2="0" y2="174" stroke="#d9dce0" stroke-width="2.4" />
          <path d="M-4,170 q-8,4 0,8" stroke="#e9b73f" stroke-width="2.4" fill="none" />
        </g>
        <!-- rear beacon lights -->
        <circle cx="10" cy="176" r="3.5" class="beacon" fill="#ffb020" />
        <circle cx="60" cy="176" r="3.5" class="beacon b2" fill="#ffb020" />
        <circle cx="110" cy="176" r="3.5" class="beacon" fill="#ffb020" />
        <circle cx="160" cy="176" r="3.5" class="beacon b2" fill="#ffb020" />
        <!-- logo on bed apron -->
        <image href={`${B}/logo.png`} x="132" y="177.5" width="40" height="26" preserveAspectRatio="xMidYMid meet" opacity=".95" />
        <!-- car riding on the deck -->
        <g class="carB">
          <use href="#car" x={carCx} y={DECK} />
        </g>
      </g>

      <!-- chassis -->
      <rect x="6" y="206" width="590" height="16" fill="#1b1c1f" />
      <rect x="236" y="196" width="104" height="30" rx="3" fill="#0d0d0f" stroke="#2a2b2f" />
      <image href={`${B}/logo.png`} x="250" y="198" width="76" height="26" preserveAspectRatio="xMidYMid meet" />

      <!-- cab + hood -->
      <path d="M345,222 L345,112 Q345,96 362,96 L440,96 L474,142 L584,150 Q596,152 596,166 L596,222 Z" fill="url(#truckBody)" />
      <path d="M440,96 L474,142 L584,150" fill="none" stroke="#3a3b40" stroke-width="2" />
      <path d="M362,106 L436,106 L462,138 L358,138 Z" fill="url(#glass)" />
      <path d="M372,106 L392,106 L372,138 L358,138 Z" fill="#fff" opacity=".08" />
      <rect x="356" y="143" width="108" height="76" rx="6" fill="none" stroke="#2c2d31" stroke-width="2" />
      <rect x="440" y="170" width="16" height="4" rx="2" fill="url(#chrome)" />
      <image href={`${B}/logo.png`} x="366" y="150" width="86" height="60" preserveAspectRatio="xMidYMid meet" />
      <!-- exhaust stack -->
      <rect x="336" y="60" width="7" height="110" rx="3" fill="url(#chrome)" />
      <!-- mirror -->
      <rect x="470" y="118" width="6" height="30" rx="2" fill="url(#chrome)" />
      <!-- roof light bar -->
      <rect x="378" y="88" width="64" height="9" rx="3" fill="#1a1a1c" />
      <rect x="381" y="89.5" width="26" height="6" rx="2" class="beacon" fill="#ffb020" />
      <rect x="413" y="89.5" width="26" height="6" rx="2" class="beacon b2" fill="#ff3b2e" />
      <!-- grille, bumper, headlight -->
      <rect x="580" y="156" width="14" height="52" rx="3" fill="url(#chrome)" />
      <g stroke="#2a2b2f" stroke-width="2"><line x1="582" y1="166" x2="592" y2="166" /><line x1="582" y1="176" x2="592" y2="176" /><line x1="582" y1="186" x2="592" y2="186" /><line x1="582" y1="196" x2="592" y2="196" /></g>
      <rect x="584" y="208" width="18" height="16" rx="3" fill="url(#chrome)" />
      <rect x="566" y="154" width="12" height="14" rx="3" fill="#fff4cc" />
      <path d="M598,160 L1000,190 L1000,130 Z" fill="#fff4cc" opacity=".07" />
      <!-- running lights along the skirt -->
      <g fill="#ffb020"><circle cx="352" cy="214" r="2.2" /><circle cx="470" cy="214" r="2.2" /><circle cx="540" cy="214" r="2.2" /></g>

      <!-- fenders + wheels -->
      <path d="M205,222 A35,35 0 0 1 275,222 Z" fill="#050506" />
      <path d="M485,222 A35,35 0 0 1 555,222 Z" fill="#050506" />
      <g transform="translate(240,220)"><use href="#wheel" /></g>
      <g transform="translate(520,220)"><use href="#wheel" /></g>
    </g>
  </svg>
</div>

<style is:global>
  .scene { position: relative; width: 100%; overflow: hidden; border-block: 2px solid var(--gold-dim); background: #000; }
  .scene svg { display: block; width: 100%; height: auto; max-height: 520px; }

  .scene .truck { transform: translate(1150px, 0); animation: truck 16s infinite; }
  .scene .bed { transform-origin: 300px 178px; animation: bed 16s infinite; }
  .scene .carA { animation: carA 16s infinite; transform-origin: 240px 250px; }
  .scene .carB { opacity: 0; animation: carB 16s infinite; }
  .scene .cable { opacity: 0; animation: cable 16s infinite; }
  .scene .spin { animation: spin 16s infinite; }
  .scene use[href="#wheel"] { }
  .scene .beacon { animation: blink 0.8s steps(1) infinite; }
  .scene .beacon.b2 { animation-delay: .4s; }
  .scene .hazard { animation: blink 1s steps(1) infinite; }
  .scene .spin { transform-box: fill-box; transform-origin: center; }

  @keyframes truck {
    0%   { transform: translate(1150px, 0); animation-timing-function: cubic-bezier(.2,.7,.3,1); }
    22%  { transform: translate(330px, 0); }
    74%  { transform: translate(330px, 0); animation-timing-function: cubic-bezier(.55,0,.9,.6); }
    98%, 100% { transform: translate(1400px, 0); }
  }
  @keyframes bed {
    0%, 26% { transform: rotate(0); animation-timing-function: ease-in-out; }
    36%, 58% { transform: rotate(calc(-1 * var(--tilt))); animation-timing-function: ease-in-out; }
    66%, 100% { transform: rotate(0); }
  }
  @keyframes carA {
    0%   { opacity: 0; transform: none; }
    3%, 38% { opacity: 1; transform: none; animation-timing-function: ease-in-out; }
    54%, 55.9% { opacity: 1; transform: translate(var(--dx), var(--dy)) rotate(calc(-1 * var(--tilt))); }
    56%, 100% { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(calc(-1 * var(--tilt))); }
  }
  @keyframes carB {
    0%, 55.9% { opacity: 0; }
    56%, 100% { opacity: 1; }
  }
  @keyframes cable {
    0%, 35.9% { opacity: 0; transform: scaleX(1); }
    36% { opacity: 1; transform: scaleX(1); animation-timing-function: ease-in-out; }
    54%, 66% { opacity: 1; transform: scaleX(.06); }
    66.1%, 100% { opacity: 0; transform: scaleX(.06); }
  }
  @keyframes spin {
    0%   { transform: rotate(0); animation-timing-function: cubic-bezier(.2,.7,.3,1); }
    22%, 74% { transform: rotate(-1570deg); animation-timing-function: cubic-bezier(.55,0,.9,.6); }
    98%, 100% { transform: rotate(380deg); }
  }
  @keyframes blink { 50% { opacity: .15; } }

  @media (prefers-reduced-motion: reduce) {
    .scene .truck { animation: none; transform: translate(330px, 0); }
    .scene .bed, .scene .carA, .scene .cable, .scene .spin, .scene .beacon, .scene .hazard { animation: none; }
    .scene .carB { animation: none; opacity: 1; }
    .scene .carA { opacity: 0; }
  }
</style>
