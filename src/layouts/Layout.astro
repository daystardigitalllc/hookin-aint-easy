---
import '../styles/global.css';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, description } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'AutomotiveBusiness',
  name: "Hookin' Ain't Easy Towing & Recovery",
  description,
  telephone: '+1-615-588-7565',
  image: `${B}/logo.png`,
  openingHours: 'Mo-Su 00:00-24:00',
  address: { '@type': 'PostalAddress', streetAddress: '896 W Albert Gallatin Ave', addressLocality: 'Gallatin', addressRegion: 'TN', addressCountry: 'US' },
  areaServed: { '@type': 'GeoCircle', geoMidpoint: { '@type': 'GeoCoordinates', latitude: 36.3884, longitude: -86.4467 }, geoRadius: 80467 },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${B}/logo.png`} />
    <link rel="icon" type="image/png" href={`${B}/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,700;1,800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <slot />
  </body>
</html>
